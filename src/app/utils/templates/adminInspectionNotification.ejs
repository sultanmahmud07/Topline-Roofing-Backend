<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>New Inspection Request</title>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: #f4f4f5;
        color: #1f2937;
        margin: 0;
        padding: 0;
      }
      .email-wrapper {
        background-color: #ffffff;
        max-width: 600px;
        margin: 20px auto;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      }
      .header {
        background-color: #18181b;
        text-align: center;
        padding: 30px 20px;
      }
      .header img {
        height: 50px;
        margin-bottom: 15px;
      }
      .header h1 {
        color: #ea580c; /* Orange accent */
        font-size: 22px;
        margin: 0;
        font-weight: 700;
        letter-spacing: -0.025em;
      }
      .content {
        padding: 30px 25px;
      }
      .section-title {
        font-size: 16px;
        font-weight: 700;
        color: #18181b;
        margin: 20px 0 10px 0;
        padding-bottom: 6px;
        border-bottom: 2px solid #e2e8f0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .details-box {
        background-color: #f8fafc;
        border-left: 4px solid #ea580c;
        border-radius: 6px;
        padding: 20px;
        margin-bottom: 20px;
      }
      .grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
      }
      .item {
        margin-bottom: 12px;
      }
      .item:last-child {
        margin-bottom: 0;
      }
      .label {
        font-size: 11px;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 4px;
        font-weight: 600;
      }
      .value {
        font-size: 15px;
        font-weight: 500;
        color: #0f172a;
        margin: 0;
      }
      .value-highlight {
        color: #ea580c;
        font-weight: 700;
      }
      .notes-box {
        background-color: #f1f5f9;
        border-radius: 6px;
        padding: 15px;
        font-style: italic;
        color: #334155;
        font-size: 14px;
        margin-top: 5px;
      }
      .footer {
        background-color: #18181b;
        color: #ffffff;
        text-align: center;
        padding: 20px;
        font-size: 13px;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      
      <div class="header">
        <img src="https://i.ibb.co.com/ZRkqH3kJ/logo.jpg" alt="Texas Precision Roofing" />
        <h1>🔔 New Inspection Scheduled</h1>
      </div>

      <div class="content">
        <p style="font-size: 15px; line-height: 1.5; margin-top: 0;">
          A new inspection booking has been submitted. Below are the details:
        </p>

        <div class="section-title">Customer Information</div>
        <div class="details-box">
          <div class="item">
            <div class="label">Name</div>
            <p class="value"><%= firstName %> <%= lastName %></p>
          </div>
          <div class="item">
            <div class="label">Phone</div>
            <p class="value"><%= phone %></p>
          </div>
          <div class="item">
            <div class="label">Email</div>
            <p class="value"><%= email %></p>
          </div>
          <div class="item">
            <div class="label">Address</div>
            <p class="value"><%= address %></p>
          </div>
        </div>

        <div class="section-title">Inspection Details</div>
        <div class="details-box" style="border-left-color: #10b981;">
          <div class="item">
            <div class="label">Service Type</div>
            <p class="value"><%= service %></p>
          </div>
          <div class="item">
            <div class="label">Scheduled Date & Time</div>
            <p class="value value-highlight"><%= formattedDate %> at <%= time %></p>
          </div>
          <div class="item">
            <div class="label">Lead Source / Sender</div>
            <p class="value" style="font-weight: 600;"><%= sender %></p>
          </div>
        </div>

        <div class="section-title">Customer Notes</div>
        <div class="notes-box">
          <%= notes %>
        </div>
      </div>

      <div class="footer">
        Texas Precision Roofing & Contracting — Admin Notification
      </div>

    </div>
  </body>
</html>
